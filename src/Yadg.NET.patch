+++ b/Yadg.NET/WebsiteBuilder.cs
@@ -21,7 +21,16 @@ namespace YadgNet
         public WebsiteBuilder(IPageSave saver)
             => this.saver = saver;
 
+        // The compiler names a constructor #ctor, and writes the dots in the name of an
+        // explicitly implemented interface member as '#'. In a link that character begins the
+        // fragment, so the browser asked for the path before it; it is written %23.
+        internal static string InLink(string name)
+            => name.Replace("#", "%23");
+
         internal static string? GetLinkWithinAsmByName(string cref)
+            => LinkWithinAsmByName(cref) is { } link ? InLink(link) : null;
+
+        private static string? LinkWithinAsmByName(string cref)
             => (cref[..2], cref[2..]) switch
             {
                 (_, var containsSystem) when NameParser.GetMethodName(cref).Contains("System")
